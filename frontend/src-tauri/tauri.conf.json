{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SupplierIntel",
  "version": "0.1.0",
  "identifier": "com.supplierintel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --mode tauri",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SupplierIntel",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/supplierintel-backend"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
